  },
  "entity_tax_treatment": {
    "sole_proprietor": {
      "label": "Sole Proprietorship",
      "liability": "unlimited",
      "tax_method": "pass_through",
      "double_taxation": false,
      "notes": "Owner reports business income on personal tax return"
    },
    "llc": {
      "label": "Limited Liability Company (LLC)",
      "liability": "limited",
      "tax_method": "pass_through",
      "double_taxation": false,
      "notes": "No separate corporate tax; profit passes to owner's personal return"
    },
    "s_corp": {
      "label": "S Corporation",
      "liability": "limited",
      "tax_method": "pass_through",
      "double_taxation": false,
      "notes": "Pass-through taxation; max 100 shareholders"
    },
    "c_corp": {
      "label": "C Corporation",
      "liability": "limited",
      "tax_method": "corporate",
      "double_taxation": true,
      "notes": "Taxed at corporate level AND shareholders taxed on dividends"
    },
    "partnership": {
      "label": "General Partnership",
      "liability": "unlimited",
      "tax_method": "pass_through",
      "double_taxation": false,
      "notes": "Income passes through to partners' personal returns"
    },
    "nonprofit": {
      "label": "Nonprofit Corporation",
      "liability": "limited",
      "tax_method": "exempt",
      "double_taxation": false,
      "notes": "Tax-exempt; donations may be tax-deductible for donors"
    }
  },
  "ratios": {
    "gross_margin":         "Gross Margin %",
