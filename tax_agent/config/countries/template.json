  "tax": {
    "vat": {
      "enabled": true,
      "standard_rate": 0.15,
      "reduced_rate": 0.0,
      "exempt_categories": [],
      "label": "VAT"
    },
    "corporate_income_tax": {
      "enabled": true,
      "method": "brackets",
      "flat_rate": 0.28,
      "brackets": [
        { "from": 0,      "to": 100000, "rate": 0.18 },
        { "from": 100000, "to": 365000, "rate": 0.26 },
        { "from": 365000, "to": null,   "rate": 0.28 }
      ],
      "label": "Corporate Income Tax"
    },
    "dividend_withholding_tax": {
      "enabled": false,
      "rate": 0.20,
      "label": "Dividend Withholding Tax"
    },
    "payroll_tax": {
      "enabled": false,
      "employee_rate": 0.0,
      "employer_rate": 0.0,
      "label": "Payroll Tax"
    }
  },
  "categories": {
    "income":             ["revenue", "sales", "service_income", "other_income", "interest_income", "rental_income"],
    "cogs":               ["cost_of_sales", "direct_costs", "inventory_cost", "materials", "freight_in"],
    "operating_expense":  ["salaries", "wages", "rent", "utilities", "marketing", "advertising",
