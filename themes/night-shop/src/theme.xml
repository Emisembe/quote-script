<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE html>
<html b:version='2' expr:dir='data:blog.languageDirection' xmlns='http://www.w3.org/1999/xhtml' xmlns:b='http://www.google.com/2005/gml/b' xmlns:data='http://www.google.com/2005/gml/data' xmlns:expr='http://www.google.com/2005/gml/expr'>
<head>
<meta content='width=device-width, initial-scale=1' name='viewport'/>
<meta content='#111111' name='theme-color'/>
<b:include data='blog' name='all-head-content'/>
<title>
<b:if cond='data:blog.pageType == &quot;index&quot;'>
<data:blog.pageTitle/>
<b:else/>
<b:if cond='data:blog.pageType != &quot;error_page&quot;'>
<data:blog.pageName/> - <data:blog.title/>
<b:else/>
Page not found - <data:blog.title/>
</b:if>
</b:if>
</title>
<link href='https://fonts.googleapis.com' rel='preconnect'/>
<link crossorigin='anonymous' href='https://fonts.gstatic.com' rel='preconnect'/>
<link href='https://fonts.googleapis.com/css2?family=Oswald:wght@500;600&amp;family=Open+Sans:wght@400;600;700&amp;display=swap' rel='stylesheet'/>
<b:skin><![CDATA[@@SKIN_CSS@@]]></b:skin>
<b:if cond='data:blog.url == data:blog.homepageUrl'>
<style type='text/css'>.hero, .talk, .topics, .promo, .partners { display: block; }</style>
</b:if>
<b:if cond='data:blog.canonicalUrl == data:blog.homepageUrl'>
<style type='text/css'>.hero, .talk, .topics, .promo, .partners { display: block; }</style>
</b:if>
</head>
<body expr:class='&quot;rm shop pt-&quot; + data:blog.pageType'>
<a class='skip-link' data-i18n='' href='#content'>Skip to content</a>

<!-- ================= Announcement bar (every page; empty gadget = no bar) ================= -->
<div class='announce' id='announce'>
  <b:section class='announce-section' id='announce-widgets' maxwidgets='1' showaddelement='no'>
    <b:widget id='HTML14' locked='false' title='Announcement bar' type='HTML'>
      <b:widget-settings>
        <b:widget-setting name='content'><![CDATA[Free shipping from 50 € | /p/shipping.html
Order easily on WhatsApp or Telegram
New arrivals every week]]></b:widget-setting>
      </b:widget-settings>
      <b:includable id='main'>
        <div class='shop-announce'><data:content/></div>
        <b:include name='quickedit'/>
      </b:includable>
    </b:widget>
  </b:section>
</div>

<!-- ================= Header ================= -->
<header class='site-header' id='site-header'>
  <div class='container header-inner'>
<div class='lang-switch' data-lang-switch='' hidden='hidden'/>
<a aria-label='Cart' class='cart-button' data-cart-open='' data-i18n-label='' href='#cart'>
  <svg aria-hidden='true' height='22' viewBox='0 0 24 24' width='22'><path d='M6 6h15l-1.5 9h-12z' fill='none' stroke='currentColor' stroke-width='2'/><circle cx='9' cy='20' fill='currentColor' r='1.5'/><circle cx='18' cy='20' fill='currentColor' r='1.5'/><path d='M6 6L5 2H2' fill='none' stroke='currentColor' stroke-width='2'/></svg>
  <span data-cart-count='' hidden='hidden'>0</span>
</a>
    <b:section class='brand-section' id='header' maxwidgets='1' showaddelement='no'>
      <b:widget id='Header1' locked='true' title='Blog title (Header)' type='Header' version='1'>
        <b:includable id='main'>
          <a class='brand' expr:href='data:blog.homepageUrl'>
            <b:if cond='data:useImage'>
              <b:if cond='data:imagePlacement == &quot;REPLACE&quot;'>
                <span class='brand-logo'><img expr:alt='data:title' expr:src='data:sourceUrl'/></span>
              <b:else/>
                <span aria-hidden='true' class='brand-mark brand-mark-img'><img alt='' expr:src='data:sourceUrl'/></span>
                <span class='brand-text'>
                  <span class='brand-name'><data:title/></span>
                  <b:if cond='data:description != &quot;&quot;'>
                    <span class='brand-tagline'><data:description/></span>
                  </b:if>
                </span>
              </b:if>
            <b:else/>
              <span aria-hidden='true' class='brand-mark'/>
              <span class='brand-text'>
                <span class='brand-name'><data:title/></span>
                <b:if cond='data:description != &quot;&quot;'>
                  <span class='brand-tagline'><data:description/></span>
                </b:if>
              </span>
            </b:if>
          </a>
        </b:includable>
      </b:widget>
    </b:section>

    <button aria-controls='site-nav' aria-expanded='false' aria-label='Open menu' class='nav-toggle' data-i18n-label='' id='nav-toggle' type='button'>
      <svg aria-hidden='true' class='icon-menu' fill='none' height='26' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' viewBox='0 0 24 24' width='26'><line x1='3' x2='21' y1='6' y2='6'/><line x1='3' x2='21' y1='12' y2='12'/><line x1='3' x2='21' y1='18' y2='18'/></svg>
      <svg aria-hidden='true' class='icon-close' fill='none' height='26' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' viewBox='0 0 24 24' width='26'><line x1='18' x2='6' y1='6' y2='18'/><line x1='6' x2='18' y1='6' y2='18'/></svg>
    </button>

    <nav aria-label='Main' class='nav-drawer' id='site-nav'>
      <b:section class='site-nav' id='menu' maxwidgets='1' showaddelement='no'>
        <b:widget id='HTML1' locked='false' title='' type='HTML'>
          <b:widget-settings>
            <b:widget-setting name='content'><![CDATA[<ul>
<li><a href="/">Home</a></li>
<li><a href="/search/label/Women">Women</a></li>
<li><a href="/search/label/Men">Men</a></li>
<li><a href="/search/label/Sale">Sale</a></li>
<li><a href="/#categories">Categories</a></li>
</ul>]]></b:widget-setting>
          </b:widget-settings>
          @@HTML_MAIN@@
        </b:widget>
      </b:section>
      <b:section class='header-cta' id='header-cta' maxwidgets='1' showaddelement='yes'>
        <b:widget id='HTML2' locked='false' title='' type='HTML'>
          <b:widget-settings>
            <b:widget-setting name='content'><![CDATA[<a href="/p/contact.html">Contact</a>]]></b:widget-setting>
          </b:widget-settings>
          @@HTML_MAIN@@
        </b:widget>
      </b:section>
    </nav>
  </div>
</header>

<main id='content'>

<!-- ================= Hero (shown on the homepage) ================= -->
<section class='hero' id='top'>
  <div class='container hero-inner'>
    <div class='hero-grid'>
      <b:section class='hero-main' id='hero-main' showaddelement='yes'>
        <b:widget id='HTML3' locked='false' title='New collection' type='HTML'>
          <b:widget-settings>
            <b:widget-setting name='content'><![CDATA[<p data-lang="en">Fresh styles for every day and every night out. Pick your size, add to cart and order in under a minute, online, on WhatsApp or Telegram.</p>
<p data-lang="de">Neue Styles für jeden Tag und jede Nacht. Größe wählen, in den Warenkorb legen und in einer Minute bestellen: online, per WhatsApp oder Telegram.</p>
<p data-lang="fr">De nouveaux styles pour chaque jour et chaque soirée. Choisissez votre taille et commandez en une minute : en ligne, sur WhatsApp ou Telegram.</p>]]></b:widget-setting>
          </b:widget-settings>
          <b:includable id='main'>
            <div class='hero-copy'>
              <b:if cond='data:title != &quot;&quot;'>
                <p class='hero-eyebrow'><data:title/></p>
              </b:if>
              <h1 class='hero-title'><data:blog.title/></h1>
              <div class='hero-text'><data:content/></div>
            </div>
            <b:include name='quickedit'/>
          </b:includable>
        </b:widget>
        <b:widget id='HTML4' locked='false' title='' type='HTML'>
          <b:widget-settings>
            <b:widget-setting name='content'><![CDATA[<ul>
<li><a href="#shop">Shop now</a></li>
<li><a href="/search/label/Sale">See the sale</a></li>
</ul>]]></b:widget-setting>
          </b:widget-settings>
          @@HTML_MAIN@@
        </b:widget>
      </b:section>
      <b:section class='hero-side' id='hero-side' showaddelement='yes'>
        <b:widget id='HTML5' locked='false' title='Why shop with us' type='HTML'>
          <b:widget-settings>
            <b:widget-setting name='content'><![CDATA[<ul data-lang="en">
<li><strong>Free shipping</strong> on orders from 50 &euro;</li>
<li><strong>Order your way</strong>: online, WhatsApp or Telegram</li>
<li><strong>Personal service</strong>: we confirm every order</li>
</ul>
<ul data-lang="de">
<li><strong>Versandkostenfrei</strong> ab 50 &euro;</li>
<li><strong>Bestellen, wie Sie möchten</strong>: online, WhatsApp oder Telegram</li>
<li><strong>Persönlicher Service</strong>: wir bestätigen jede Bestellung</li>
</ul>
<ul data-lang="fr">
<li><strong>Livraison gratuite</strong> dès 50 &euro;</li>
<li><strong>Commandez comme vous voulez</strong> : en ligne, WhatsApp ou Telegram</li>
<li><strong>Service personnel</strong> : nous confirmons chaque commande</li>
</ul>]]></b:widget-setting>
          </b:widget-settings>
          <b:includable id='main'>
            <div class='perk-card'>
              <b:if cond='data:title != &quot;&quot;'>
                <p class='perk-title'><data:title/></p>
              </b:if>
              <div class='perk-list'><data:content/></div>
            </div>
            <b:include name='quickedit'/>
          </b:includable>
        </b:widget>
      </b:section>
    </div>
  </div>
</section>

<!-- ================= Talk to us: call and video buttons (shown on the homepage) ================= -->
<section class='talk' id='talk'>
  <div class='container'>
    <b:section class='talk-section' id='talk-widgets' showaddelement='yes'>
      <b:widget id='HTML11' locked='false' title='Talk to us' type='HTML'>
        <b:widget-settings>
          <b:widget-setting name='content'><![CDATA[text: Prefer to talk? Call us or join a video call at these times.
call: +49 157 00000000 | Mon–Fri 9:00–18:00
zoom: https://zoom.us/j/0000000000 | Tue & Thu 18:00–19:00
meet: https://meet.google.com/abc-defg-hij | Sat 10:00–12:00]]></b:widget-setting>
        </b:widget-settings>
        <b:includable id='main'>
          <b:if cond='data:title != &quot;&quot;'>
            <h2 class='title'><data:title/></h2>
          </b:if>
          <div class='shop-contact'><data:content/></div>
          <b:include name='quickedit'/>
        </b:includable>
      </b:widget>
    </b:section>
  </div>
</section>

<!-- ================= Posts ================= -->
<div class='page-main' id='shop'>
  <div class='container main-grid'>
    <div class='main-col'>
      <b:section class='main' id='main' showaddelement='no'>
        <b:widget id='Blog1' locked='true' title='New arrivals' type='Blog' version='1'>
          <b:widget-settings>
            <b:widget-setting name='showDateHeader'>false</b:widget-setting>
            <b:widget-setting name='showShareButtons'>false</b:widget-setting>
            <b:widget-setting name='authorLabel'>By</b:widget-setting>
            <b:widget-setting name='showCommentLink'>true</b:widget-setting>
            <b:widget-setting name='showAuthor'>true</b:widget-setting>
            <b:widget-setting name='style.unittype'>TextAndImage</b:widget-setting>
            <b:widget-setting name='reactionsLabel'/>
            <b:widget-setting name='showAuthorProfile'>false</b:widget-setting>
            <b:widget-setting name='style.layout'>1x1</b:widget-setting>
            <b:widget-setting name='showLabels'>true</b:widget-setting>
            <b:widget-setting name='showLocation'>false</b:widget-setting>
            <b:widget-setting name='showTimestamp'>false</b:widget-setting>
            <b:widget-setting name='postsPerAd'>3</b:widget-setting>
            <b:widget-setting name='showBacklinks'>false</b:widget-setting>
            <b:widget-setting name='showInlineAds'>false</b:widget-setting>
            <b:widget-setting name='showReactions'>false</b:widget-setting>
          </b:widget-settings>
          <b:includable id='main' var='top'>
            <b:if cond='data:blog.pageType == &quot;error_page&quot;'>
              <b:include name='rmNotFound'/>
            <b:else/>
              <b:if cond='data:blog.pageType == &quot;item&quot;'>
                <b:loop values='data:posts' var='post'>
                  <b:include data='post' name='shopItem'/>
                </b:loop>
                <b:include name='rmItemPager'/>
              <b:else/>
                <b:if cond='data:blog.pageType == &quot;static_page&quot;'>
                  <b:loop values='data:posts' var='post'>
                    <b:include data='post' name='rmSingle'/>
                  </b:loop>
                <b:else/>
                  <b:include name='rmList'/>
                </b:if>
              </b:if>
            </b:if>
          </b:includable>

          <b:includable id='rmList'>
            <div class='section-head'>
              <b:if cond='data:blog.url == data:blog.homepageUrl'>
                <h2 class='section-title'><data:title/></h2>
              <b:else/>
              <b:if cond='data:blog.canonicalUrl == data:blog.homepageUrl'>
                <h2 class='section-title'><data:title/></h2>
              <b:else/>
                <h1 class='section-title'>
                <b:if cond='data:blog.searchQuery'>
                  Search: <data:blog.searchQuery/>
                <b:else/>
                  <b:if cond='data:blog.url == data:blog.homepageUrl'>
                    <data:title/>
                  <b:else/>
                    <b:if cond='data:blog.pageName != &quot;&quot;'>
                      <data:blog.pageName/>
                    <b:else/>
                      <data:title/>
                    </b:if>
                  </b:if>
                </b:if>
              </h1>
              </b:if>
              </b:if>
              <b:include name='rmSearchForm'/>
            </div>
            <b:if cond='data:numPosts != 0'>
              <div class='post-grid shop-grid'>
                <b:loop values='data:posts' var='post'>
                  <b:include data='post' name='shopCard'/>
                </b:loop>
              </div>
            <b:else/>
              <div class='empty-state'>
                <p data-i18n=''>No posts found here yet.</p>
                <a class='btn btn-primary' data-i18n='' expr:href='data:blog.homepageUrl'>Back to home</a>
              </div>
            </b:if>
            <b:if cond='data:newerPageUrl'>
              <b:include name='rmListPager'/>
            <b:else/>
              <b:if cond='data:olderPageUrl'>
                <b:include name='rmListPager'/>
              </b:if>
            </b:if>
          </b:includable>

          <b:includable id='shopCard' var='post'>
  <article class='shop-card' expr:data-id='data:post.id' expr:data-url='data:post.url' expr:data-title='data:post.title' expr:data-image='data:post.firstImageUrl'>
    <a aria-hidden='true' class='shop-card-media' expr:href='data:post.url' tabindex='-1'>
      <b:if cond='data:post.firstImageUrl'>
        <img class='shop-img' expr:alt='data:post.title' expr:src='data:post.firstImageUrl' loading='lazy'/>
      <b:else/>
        <b:if cond='data:post.thumbnailUrl'>
          <img class='shop-img' expr:alt='data:post.title' expr:src='data:post.thumbnailUrl' loading='lazy'/>
        </b:if>
      </b:if>
    </a>
    <h2 class='shop-card-title'><a expr:href='data:post.url'><data:post.title/></a></h2>
    <div class='shop-card-buy'/>
    <b:loop values='data:post.labels' var='label'>
      <span class='shop-src' expr:data-label='data:label.name'/>
    </b:loop>
    <!-- The post body (up to the jump break) carries the product block. Inside
         <template> it is inert: no images download, no scripts run. -->
    <template class='shop-src'><data:post.body/></template>
  </article>
</b:includable>

<b:includable id='shopItem' var='post'>
  <article class='shop-item' expr:data-id='data:post.id' expr:data-url='data:post.url' expr:data-title='data:post.title' expr:data-image='data:post.firstImageUrl'>
    <a expr:name='data:post.id'/>
    <div class='shop-top'>
      <div class='shop-gallery'/>
      <div class='shop-summary'>
        <b:if cond='data:post.labels'>
          <p class='shop-cats'>
            <b:loop values='data:post.labels' var='label'>
              <a class='shop-cat' expr:data-label='data:label.name' expr:href='data:label.url' rel='tag'><data:label.name/></a>
            </b:loop>
          </p>
        </b:if>
        <h1 class='post-title'><data:post.title/></h1>
        <div class='shop-buy'/>
        <div class='shop-share'>
          <a expr:href='&quot;https://api.whatsapp.com/send?text=&quot; + data:post.url' rel='nofollow noopener' target='_blank'>WhatsApp</a>
          <a expr:href='&quot;https://www.facebook.com/sharer/sharer.php?u=&quot; + data:post.url' rel='nofollow noopener' target='_blank'>Facebook</a>
          <a expr:href='&quot;https://pinterest.com/pin/create/button/?url=&quot; + data:post.url' rel='nofollow noopener' target='_blank'>Pinterest</a>
          <b:include data='post' name='postQuickEdit'/>
        </div>
      </div>
    </div>
    <div class='post-body' expr:id='&quot;post-body-&quot; + data:post.id'>
      <data:post.body/>
    </div>
    <!-- Blogger comments, shown as reviews. Needs the theme's own comment_picker and
         postQuickEdit includables (every Blogger-generated theme has them). -->
    <div class='shop-reviews'>
      <b:include data='post' name='comment_picker'/>
    </div>
  </article>
</b:includable>

          <b:includable id='rmCard' var='post'>
            <article class='post-card'>
              <a aria-hidden='true' class='post-card-media' expr:href='data:post.url' tabindex='-1'>
                <b:if cond='data:post.firstImageUrl'>
                  <img class='js-resize' expr:alt='data:post.title' expr:src='data:post.firstImageUrl' loading='lazy'/>
                <b:else/>
                  <b:if cond='data:post.thumbnailUrl'>
                    <img class='js-resize' expr:alt='data:post.title' expr:src='data:post.thumbnailUrl' loading='lazy'/>
                  <b:else/>
                    <span class='post-card-placeholder'>
                      <svg aria-hidden='true' fill='none' height='40' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.8' viewBox='0 0 24 24' width='40'><path d='M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z'/><path d='M19 10v2a7 7 0 0 1-14 0v-2'/><line x1='12' x2='12' y1='19' y2='23'/><line x1='8' x2='16' y1='23' y2='23'/></svg>
                    </span>
                  </b:if>
                </b:if>
              </a>
              <div class='post-card-body'>
                <b:if cond='data:post.labels'>
                  <div class='post-card-labels'>
                    <b:loop index='x' values='data:post.labels' var='label'>
                      <b:if cond='data:x == 0'>
                        <a class='badge' expr:href='data:label.url'><data:label.name/></a>
                      </b:if>
                    </b:loop>
                  </div>
                </b:if>
                <h3 class='post-card-title'>
                  <a expr:href='data:post.url'><b:if cond='data:post.title'><data:post.title/><b:else/>Untitled post</b:if></a>
                </h3>
                <div class='post-card-meta'>
                  <time class='js-date' expr:datetime='data:post.timestampISO8601'><data:post.timestamp/></time>
                  <b:if cond='data:post.allowComments'>
                    <b:if cond='data:post.numComments != 0'>
                      <span class='post-card-comments'><data:post.numComments/> <b:if cond='data:post.numComments == 1'>comment<b:else/>comments</b:if></span>
                    </b:if>
                  </b:if>
                </div>
              </div>
            </article>
          </b:includable>

          <b:includable id='rmSingle' var='post'>
            <article class='post-single post'>
              <a expr:name='data:post.id'/>
              <header class='post-head'>
                <b:if cond='data:post.labels'>
                  <div class='post-labels'>
                    <b:loop values='data:post.labels' var='label'>
                      <a class='badge' expr:href='data:label.url' rel='tag'><data:label.name/></a>
                    </b:loop>
                  </div>
                </b:if>
                <b:if cond='data:post.title'>
                  <h1 class='post-title entry-title'><data:post.title/></h1>
                </b:if>
                <b:if cond='data:blog.pageType == &quot;item&quot;'>
                  <div class='post-meta'>
                    <b:if cond='data:post.authorProfileUrl'>
                      <a class='post-author' expr:href='data:post.authorProfileUrl' rel='author'><data:post.author/></a>
                    <b:else/>
                      <span class='post-author'><data:post.author/></span>
                    </b:if>
                    <span aria-hidden='true' class='sep'/>
                    <time class='published js-date' expr:datetime='data:post.timestampISO8601'><data:post.timestamp/></time>
                    <b:include data='post' name='postQuickEdit'/>
                  </div>
                </b:if>
              </header>
              <div class='post-body entry-content' expr:id='&quot;post-body-&quot; + data:post.id'>
                <data:post.body/>
              </div>
              <b:if cond='data:blog.pageType == &quot;item&quot;'>
                <div class='post-share'>
                  <span class='post-share-label'>Share</span>
                  <a expr:href='&quot;https://www.facebook.com/sharer/sharer.php?u=&quot; + data:post.url' rel='nofollow noopener' target='_blank'>Facebook</a>
                  <a expr:href='&quot;https://twitter.com/intent/tweet?url=&quot; + data:post.url' rel='nofollow noopener' target='_blank'>X</a>
                  <a expr:href='&quot;https://www.linkedin.com/sharing/share-offsite/?url=&quot; + data:post.url' rel='nofollow noopener' target='_blank'>LinkedIn</a>
                  <a expr:href='&quot;https://api.whatsapp.com/send?text=&quot; + data:post.url' rel='nofollow noopener' target='_blank'>WhatsApp</a>
                  <button expr:data-copy-url='data:post.url' type='button'>Copy link</button>
                </div>
              </b:if>
              <b:include data='post' name='comment_picker'/>
            </article>
          </b:includable>

          <b:includable id='rmItemPager'>
            <nav aria-label='More posts' class='blog-pager-nav'>
              <b:if cond='data:newerPageUrl'>
                <a class='btn btn-outline newer' expr:href='data:newerPageUrl' expr:title='data:newerPageTitle'>&#8592; <span data-i18n=''>Newer post</span></a>
              </b:if>
              <b:if cond='data:olderPageUrl'>
                <a class='btn btn-outline older' expr:href='data:olderPageUrl' expr:title='data:olderPageTitle'><span data-i18n=''>Older post</span> &#8594;</a>
              </b:if>
            </nav>
          </b:includable>

          <b:includable id='rmListPager'>
            <nav aria-label='Pages' class='blog-pager-nav'>
              <b:if cond='data:newerPageUrl'>
                <a class='btn btn-outline newer' expr:href='data:newerPageUrl'>&#8592; <span data-i18n=''>Newer posts</span></a>
              </b:if>
              <b:if cond='data:olderPageUrl'>
                <a class='btn btn-primary older' expr:href='data:olderPageUrl'><span data-i18n=''>Older posts</span> &#8594;</a>
              </b:if>
            </nav>
