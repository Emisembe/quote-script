<b:includable id='main'>
  <a class='brand notranslate' expr:href='data:blog.homepageUrl' translate='no'>
    <b:if cond='data:useImage'>
      <img class='brand-logo' expr:alt='data:title' expr:src='data:sourceUrl'/>
    <b:else/>
      <span class='brand-name'><data:title/></span>
    </b:if>
  </a>
</b:includable>
