<b:includable id='main'>
  <b:if cond='data:title != &quot;&quot;'>
    <h2 class='card-title'><data:title/></h2>
  </b:if>
  <b:include name='content'/>
</b:includable>
<b:includable id='content'>
  <div class='featured-post'>
    <b:if cond='data:showFirstImage and data:postFirstImage != &quot;&quot;'>
      <a class='featured-media fit-frame' expr:href='data:postUrl'><img alt='' class='js-resize' expr:src='data:postFirstImage' loading='lazy'/></a>
    </b:if>
    <b:if cond='data:showPostTitle and data:postTitle != &quot;&quot;'>
      <h3 class='featured-title'><a expr:href='data:postUrl'><data:postTitle/></a></h3>
    </b:if>
    <b:if cond='data:showSnippet and data:postSummary != &quot;&quot;'>
      <p class='featured-snippet'><data:postSummary/></p>
      <a class='text-link' expr:href='data:postUrl'>Read more</a>
    </b:if>
  </div>
</b:includable>
