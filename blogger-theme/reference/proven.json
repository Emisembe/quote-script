  "data_tags": {},
  "setting_values": {
   "boolean settings may be true or false": [
    "true",
    "false"
   ]
  },
  "banned_strings": [
   "YOUR_",
   "YOUR DESCRIPTION",
   "YOUR KEYWORDS",
   "soratemplates",
   "@username",
   "Facebook App ID here"
  ],
  "notes": "Anything allowed beyond the reference export goes here with a reason. Add names/addresses of other blogs found in the reference to banned_strings.",
  "accepted": {
   "no jQuery dependency": "Kept on purpose: the blog's menu builder, SlickNav mobile menu, one-page scroll nav, related posts and 'load more' all run on jQuery. It loads once, over https, from Google's CDN."
  },
  "free_text_settings": {
   "patterns": [
    "content",
    "link-\\d+",
    "text-\\d+"
   ],
   "reason": "Gadget text and link addresses are typed by the blog owner; only enum-like settings (sorting, timeRange, booleans...) must match proven values. Relative links such as /p/page.html are standard in LinkList menus."
  }
 }
