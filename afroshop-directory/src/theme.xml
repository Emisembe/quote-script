            <div class='container'>
              <b:if cond='data:title != &quot;&quot;'>
                <h2 class='block-title'><data:title/></h2>
              </b:if>
              <div class='widget-content js-categories'><data:content/></div>
            </div>
          </div>
          <b:include name='quickedit'/>
        </b:includable>
      </b:widget>
      <b:widget id='HTML20' locked='false' title='Deals of the week' type='HTML'>
