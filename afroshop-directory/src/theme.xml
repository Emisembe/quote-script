<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE html>
<html b:version='2' expr:dir='data:blog.languageDirection' xmlns='http://www.w3.org/1999/xhtml' xmlns:b='http://www.google.com/2005/gml/b' xmlns:data='http://www.google.com/2005/gml/data' xmlns:expr='http://www.google.com/2005/gml/expr'>
<head>
<meta content='width=device-width, initial-scale=1' name='viewport'/>
<b:include data='blog' name='all-head-content'/>
<title>
<b:if cond='data:blog.pageType == &quot;index&quot;'>
<data:blog.pageTitle/>
<b:else/>
<b:if cond='data:blog.pageType != &quot;error_page&quot;'>
<data:blog.pageName/> - <data:blog.title/>
<b:else/>
Page not found - <data:blog.title/>
</b:if>
</b:if>
</title>
<b:skin><![CDATA[@@SKIN_CSS@@]]></b:skin>
<b:if cond='data:blog.url == data:blog.homepageUrl'>
<style type='text/css'>.home-only { display: block; } .finder-band { margin-top: -64px; padding-top: 0; }</style>
</b:if>
<b:if cond='data:blog.canonicalUrl == data:blog.homepageUrl'>
<style type='text/css'>.home-only { display: block; } .finder-band { margin-top: -64px; padding-top: 0; }</style>
</b:if>
</head>
<body expr:class='&quot;dir pt-&quot; + data:blog.pageType'>
<a class='skip-link' href='#content'>Skip to content</a>

<!-- ================= Header ================= -->
<!-- ================= Announcement bar (remove the gadget in Layout to hide it) ================= -->
<b:section class='announce-section' id='announce' maxwidgets='1' showaddelement='yes'>
  <b:widget id='HTML13' locked='false' title='Announcement bar' type='HTML'>
    <b:widget-settings>
      <b:widget-setting name='content'><![CDATA[New: a free listing for every African shop in Germany – <a href="/p/list-your-shop.html">add your shop</a>]]></b:widget-setting>
    </b:widget-settings>
    <b:includable id='main'>
      <div class='announce'><div class='container announce-inner'><data:content/></div></div>
      <b:include name='quickedit'/>
    </b:includable>
  </b:widget>
</b:section>

<header class='site-header' id='site-header'>
  <div class='container header-inner'>
    <b:section class='brand-section' id='header' maxwidgets='1' showaddelement='no'>
      <b:widget id='Header1' locked='true' title='Site name (Header)' type='Header' version='1'>
        <b:includable id='main'>
          <a class='brand' expr:href='data:blog.homepageUrl'>
            <b:if cond='data:useImage'>
              <b:if cond='data:imagePlacement == &quot;REPLACE&quot;'>
                <span class='brand-logo'><img expr:alt='data:title' expr:src='data:sourceUrl'/></span>
              <b:else/>
                <span aria-hidden='true' class='brand-mark'><img alt='' expr:src='data:sourceUrl'/></span>
                <span class='brand-text'>
                  <span class='brand-name'><data:title/></span>
                  <b:if cond='data:description != &quot;&quot;'>
                    <span class='brand-tagline'><data:description/></span>
                  </b:if>
                </span>
              </b:if>
            <b:else/>
              <span aria-hidden='true' class='brand-mark brand-mark-svg'><svg aria-hidden='true' viewBox='0 0 76.0 70.5' width='40' height='37'><g transform='translate(0.000 0.000) scale(1.00000) translate(-12.0 -19.5)'><path d='M23 46 V40 A17 17 0 0 1 57 40 V46' fill='none' stroke='#E9A23B' stroke-width='7.5' stroke-linecap='round'/><path d='M43 46 V40 A17 17 0 0 1 77 40 V46' fill='none' stroke='#FBF6EE' stroke-width='7.5' stroke-linecap='round'/><defs><clipPath id='bagclip1'><path d='M23 40 L77 40 Q84 40 84.6 47 L87.4 83 Q88 90 81 90 L19 90 Q12 90 12.6 83 L15.4 47 Q16 40 23 40 Z'/></clipPath></defs><path d='M23 40 L77 40 Q84 40 84.6 47 L87.4 83 Q88 90 81 90 L19 90 Q12 90 12.6 83 L15.4 47 Q16 40 23 40 Z' fill='#FBF6EE'/><g clip-path='url(#bagclip1)'><rect x='10' y='59' width='9.5' height='12' fill='#E9A23B'/><rect x='19' y='59' width='9.5' height='12' fill='#0E4D3A'/><rect x='29' y='59' width='9.5' height='12' fill='#C4552D'/><rect x='38' y='59' width='9.5' height='12' fill='#E9A23B'/><rect x='48' y='59' width='9.5' height='12' fill='#0E4D3A'/><rect x='57' y='59' width='9.5' height='12' fill='#C4552D'/><rect x='67' y='59' width='9.5' height='12' fill='#E9A23B'/><rect x='76' y='59' width='9.5' height='12' fill='#0E4D3A'/><rect x='86' y='59' width='9.5' height='12' fill='#C4552D'/></g></g></svg></span>
              <span class='brand-text'>
                <span class='brand-name'><data:title/></span>
                <b:if cond='data:description != &quot;&quot;'>
                  <span class='brand-tagline'><data:description/></span>
                </b:if>
              </span>
            </b:if>
          </a>
        </b:includable>
      </b:widget>
    </b:section>

    <button aria-controls='site-nav' aria-expanded='false' aria-label='Open menu' class='nav-toggle' id='nav-toggle' type='button'>
      <svg aria-hidden='true' class='icon-menu' fill='none' height='26' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' viewBox='0 0 24 24' width='26'><line x1='3' x2='21' y1='6' y2='6'/><line x1='3' x2='21' y1='12' y2='12'/><line x1='3' x2='21' y1='18' y2='18'/></svg>
      <svg aria-hidden='true' class='icon-close' fill='none' height='26' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' viewBox='0 0 24 24' width='26'><line x1='18' x2='6' y1='6' y2='18'/><line x1='6' x2='18' y1='6' y2='18'/></svg>
    </button>

    <nav aria-label='Main' class='nav-drawer' id='site-nav'>
      <b:section class='site-nav' id='menu' maxwidgets='1' showaddelement='no'>
        <b:widget id='HTML1' locked='false' title='' type='HTML'>
          <b:widget-settings>
            <b:widget-setting name='content'><![CDATA[<ul>
<li><a href="/#find">Find a shop</a></li>
<li><a href="/search/label/Product">Shop</a></li>
<li><a href="/#categories">Categories</a></li>
<li><a href="/#cities">Cities</a></li>
<li><a href="/search/label/Events">Events</a></li>
</ul>]]></b:widget-setting>
          </b:widget-settings>
          @@HTML_MAIN@@
        </b:widget>
      </b:section>
      <b:section class='header-cta' id='header-cta' maxwidgets='1' showaddelement='yes'>
        <b:widget id='HTML2' locked='false' title='' type='HTML'>
          <b:widget-settings>
            <b:widget-setting name='content'><![CDATA[<a href="/p/list-your-shop.html">List your shop</a>]]></b:widget-setting>
          </b:widget-settings>
          @@HTML_MAIN@@
        </b:widget>
      </b:section>
    </nav>
  </div>
</header>

<main id='content'>

<!-- ================= Hero (homepage only) ================= -->
<section class='hero home-only'>
  <div class='container'>
    <b:section class='hero-main' id='hero-main' showaddelement='no'>
      <b:widget id='HTML3' locked='false' title='African shops across Germany' type='HTML'>
        <b:widget-settings>
          <b:widget-setting name='content'><![CDATA[<p>Find the foods, hair and beauty products, fabrics and services you grew up with, in a shop near you. Search by product, choose your city or let us find the closest shops.</p>]]></b:widget-setting>
        </b:widget-settings>
        <b:includable id='main'>
          <div class='hero-copy'>
            <b:if cond='data:title != &quot;&quot;'>
              <p class='hero-eyebrow'><data:title/></p>
            </b:if>
            <h1 class='hero-title'><data:blog.title/></h1>
            <div class='hero-text'><data:content/></div>
          </div>
          <b:include name='quickedit'/>
        </b:includable>
      </b:widget>
    </b:section>
  </div>
</section>

<!-- ================= Finder (every page) ================= -->
<section aria-label='Find a shop' class='finder-band' id='find'>
  <div class='container'>
    <form class='finder' id='finder' role='search'>
      <div class='finder-field finder-q'>
        <label class='finder-label' for='finder-q'>What are you looking for?</label>
        <input autocomplete='off' id='finder-q' name='q' placeholder='e.g. egusi, gari, braiding hair, kente' type='search'/>
      </div>
      <div class='finder-field finder-city'>
        <label class='finder-label' for='finder-city'>Where?</label>
        <select id='finder-city' name='city'>
          <option value=''>All of Germany</option>
        </select>
      </div>
      <div class='finder-buttons'>
        <button class='btn btn-ghost finder-near' id='finder-near' type='button'>
          <svg aria-hidden='true' fill='none' height='18' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' viewBox='0 0 24 24' width='18'><path d='M12 22s7-7.2 7-12a7 7 0 0 0-14 0c0 4.8 7 12 7 12z'/><circle cx='12' cy='10' r='2.5'/></svg>
          <span>Near me</span>
        </button>
        <button class='btn btn-primary finder-go' type='submit'>
          <svg aria-hidden='true' fill='none' height='18' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='2.2' viewBox='0 0 24 24' width='18'><circle cx='11' cy='11' r='7'/><line x1='20' x2='16' y1='20' y2='16'/></svg>
          <span>Search</span>
        </button>
      </div>
    </form>
  </div>
</section>
<section aria-live='polite' class='finder-results' hidden='hidden' id='finder-results'>
  <div class='container'>
    <div class='block-head'>
      <h2 class='block-title' id='finder-title'>Results</h2>
      <button class='btn btn-link' id='finder-clear' type='button'>Clear search</button>
    </div>
    <p class='finder-status' id='finder-status'/>
    <div class='card-grid' id='finder-list'/>
  </div>
</section>

<!-- ================= Homepage blocks (top) ================= -->
<div class='home-only home-blocks'>
  <b:section class='home-section' id='home-top' showaddelement='yes'>
    <b:widget id='HTML17' locked='false' title='' type='HTML'>
      <b:widget-settings>
        <b:widget-setting name='content'><![CDATA[<ul class="slides">
<li data-tone="green"><h3>All African shops in Germany, in one place</h3><p>Search by product, city or state, and see who is open right now.</p><a href="/#find">Find a shop</a></li>
<li data-tone="gold"><h3>Own a shop? Get listed for free</h3><p>Your own page with opening hours, products and a WhatsApp button within 48 hours.</p><a href="/p/list-your-shop.html">Add my shop</a></li>
<li data-tone="clay"><h3>Seminars for shop owners</h3><p>Marketing, import rules and more. Meet other shop owners and suppliers.</p><a href="/search/label/Events">See dates</a></li>
</ul>]]></b:widget-setting>
      </b:widget-settings>
      <b:includable id='main'>
        <div class='block block-slides'>
          <div class='container'>
            <b:if cond='data:title != &quot;&quot;'>
              <h2 class='block-title'><data:title/></h2>
            </b:if>
            <div aria-label='Highlights' aria-roledescription='carousel' class='widget-content slideshow js-slides' role='region'><data:content/></div>
          </div>
        </div>
        <b:include name='quickedit'/>
      </b:includable>
    </b:widget>
    <b:widget id='HTML18' locked='false' title='' type='HTML'>
      <b:widget-settings>
        <b:widget-setting name='content'><![CDATA[<ul class="benefits">
<li data-icon="free"><strong>Free for customers</strong>Search, call and message shops at no cost.</li>
<li data-icon="check"><strong>Every shop checked</strong>We talk to each shop before its page goes live.</li>
<li data-icon="clock"><strong>Open now</strong>See which shops are open before you go.</li>
<li data-icon="bag"><strong>Order and pick up</strong>Choose products online, collect them in the shop.</li>
</ul>]]></b:widget-setting>
      </b:widget-settings>
      @@HTML_MAIN@@
    </b:widget>
    <b:widget id='HTML19' locked='false' title='' type='HTML'>
      <b:widget-settings>
        <b:widget-setting name='content'><![CDATA[<ul class="banners">
<li data-tone="green"><p class="kicker">Seminar</p><h3>More customers with your phone</h3><p>A Saturday workshop for shop owners: WhatsApp, Google and photos that sell.</p><a href="/search/label/Events">Book a seat</a></li>
<li data-tone="gold"><p class="kicker">New</p><h3>Order from your favourite shop</h3><p>Choose products online, send the order, pick it up in the shop.</p><a href="/search/label/Product">Open the shop</a></li>
</ul>]]></b:widget-setting>
      </b:widget-settings>
      @@HTML_MAIN@@
    </b:widget>
    <b:widget id='HTML14' locked='false' title='How it works' type='HTML'>
      <b:widget-settings>
        <b:widget-setting name='content'><![CDATA[<ol class="howto">
<li><strong>Search</strong>Type the food, beauty product or service you need.</li>
<li><strong>Find</strong>See the shops near you and which ones are open now.</li>
<li><strong>Visit or message</strong>Call, write on WhatsApp or get directions in one tap.</li>
</ol>]]></b:widget-setting>
      </b:widget-settings>
      <b:includable id='main'>
        <div class='block block-howto'>
          <div class='container'>
            <b:if cond='data:title != &quot;&quot;'>
              <h2 class='block-title'><data:title/></h2>
            </b:if>
            <div class='widget-content'><data:content/></div>
          </div>
        </div>
        <b:include name='quickedit'/>
      </b:includable>
    </b:widget>
    <b:widget id='HTML4' locked='false' title='Browse by category' type='HTML'>
      <b:widget-settings>
        <b:widget-setting name='content'><![CDATA[<ul class="tiles" id="categories">
<li><a href="/search/label/Food">Food &amp; groceries</a></li>
<li><a href="/search/label/Hair%20%26%20Beauty">Hair &amp; beauty</a></li>
