<!-- ================= Posts (shops, events, articles) ================= -->
<div class='page-main'>
  <div class='container'>
    <b:section class='main' id='main' showaddelement='no'>
      <b:widget id='Blog1' locked='true' title='Newest listings' type='Blog' version='1'>
        <b:widget-settings>
          <b:widget-setting name='showDateHeader'>false</b:widget-setting>
          <b:widget-setting name='showShareButtons'>false</b:widget-setting>
          <b:widget-setting name='authorLabel'>By</b:widget-setting>
          <b:widget-setting name='showCommentLink'>true</b:widget-setting>
          <b:widget-setting name='showAuthor'>false</b:widget-setting>
          <b:widget-setting name='style.unittype'>TextAndImage</b:widget-setting>
          <b:widget-setting name='reactionsLabel'/>
          <b:widget-setting name='showAuthorProfile'>false</b:widget-setting>
          <b:widget-setting name='style.layout'>1x1</b:widget-setting>
          <b:widget-setting name='showLabels'>true</b:widget-setting>
          <b:widget-setting name='showLocation'>false</b:widget-setting>
          <b:widget-setting name='showTimestamp'>true</b:widget-setting>
          <b:widget-setting name='postsPerAd'>3</b:widget-setting>
          <b:widget-setting name='showBacklinks'>false</b:widget-setting>
          <b:widget-setting name='showInlineAds'>false</b:widget-setting>
          <b:widget-setting name='showReactions'>false</b:widget-setting>
        </b:widget-settings>
        <b:includable id='main' var='top'>
          <b:if cond='data:blog.pageType == &quot;error_page&quot;'>
            <b:include name='dirNotFound'/>
          <b:else/>
            <b:if cond='data:blog.pageType == &quot;item&quot;'>
              <b:loop values='data:posts' var='post'>
                <b:include data='post' name='dirSingle'/>
              </b:loop>
            <b:else/>
              <b:if cond='data:blog.pageType == &quot;static_page&quot;'>
                <b:loop values='data:posts' var='post'>
                  <b:include data='post' name='dirSingle'/>
                </b:loop>
              <b:else/>
                <b:include name='dirList'/>
              </b:if>
            </b:if>
          </b:if>
        </b:includable>

        <b:includable id='dirList'>
          <div class='block-head list-head'>
            <b:if cond='data:blog.url == data:blog.homepageUrl'>
              <h2 class='block-title'><data:title/></h2>
            <b:else/>
            <b:if cond='data:blog.canonicalUrl == data:blog.homepageUrl'>
              <h2 class='block-title'><data:title/></h2>
            <b:else/>
              <h1 class='block-title js-list-title'>
                <b:if cond='data:blog.searchQuery'>
                  Search: <data:blog.searchQuery/>
                <b:else/>
                  <b:if cond='data:blog.pageName != &quot;&quot;'>
                    <data:blog.pageName/>
                  <b:else/>
                    <data:title/>
                  </b:if>
                </b:if>
              </h1>
            </b:if>
            </b:if>
          </div>
          <b:if cond='data:numPosts != 0'>
            <div class='card-grid'>
              <b:loop values='data:posts' var='post'>
                <b:include data='post' name='dirCard'/>
              </b:loop>
            </div>
          <b:else/>
            <div class='empty-state'>
              <p>Nothing listed here yet.</p>
              <a class='btn btn-primary' expr:href='data:blog.homepageUrl'>Back to home</a>
            </div>
          </b:if>
          <b:if cond='data:newerPageUrl'>
            <b:include name='dirListPager'/>
          <b:else/>
            <b:if cond='data:olderPageUrl'>
              <b:include name='dirListPager'/>
            </b:if>
          </b:if>
        </b:includable>

        <b:includable id='dirCard' var='post'>
          <article class='dcard' expr:data-id='data:post.id' expr:data-url='data:post.url'>
            <a aria-hidden='true' class='dcard-media' expr:href='data:post.url' tabindex='-1'>
              <b:if cond='data:post.firstImageUrl'>
                <img class='js-resize' expr:alt='data:post.title' expr:src='data:post.firstImageUrl' loading='lazy'/>
              <b:else/>
                <b:if cond='data:post.thumbnailUrl'>
                  <img class='js-resize' expr:alt='data:post.title' expr:src='data:post.thumbnailUrl' loading='lazy'/>
                <b:else/>
                  <span class='dcard-ph'/>
                </b:if>
              </b:if>
            </a>
            <div class='dcard-body'>
              <p class='dcard-kicker'>
                <b:loop values='data:post.labels' var='label'>
                  <span class='dcard-label' expr:data-label='data:label.name'><data:label.name/></span>
                </b:loop>
              </p>
              <h3 class='dcard-title'><a expr:href='data:post.url'><b:if cond='data:post.title'><data:post.title/><b:else/>Untitled</b:if></a></h3>
              <p class='dcard-meta'><time class='js-date' expr:datetime='data:post.timestampISO8601'><data:post.timestamp/></time></p>
              <div class='dcard-extra'/>
            </div>
            <!-- The post body carries the shop or event details. Inside <template> it is
                 inert: no images download and no scripts run until the script reads it. -->
            <template class='dcard-src'><data:post.body/></template>
          </article>
        </b:includable>

        <b:includable id='dirSingle' var='post'>
          <article class='entry post' expr:data-id='data:post.id' expr:data-url='data:post.url'>
            <a expr:name='data:post.id'/>
            <header class='entry-head'>
              <b:if cond='data:post.labels'>
                <div class='entry-labels'>
                  <b:loop values='data:post.labels' var='label'>
                    <a class='badge' expr:data-label='data:label.name' expr:href='data:label.url' rel='tag'><data:label.name/></a>
                  </b:loop>
                </div>
              </b:if>
              <b:if cond='data:post.title'>
                <h1 class='entry-title'><data:post.title/></h1>
              </b:if>
              <b:if cond='data:blog.pageType == &quot;item&quot;'>
                <p class='entry-meta'>
                  <span class='entry-updated'>Listed <time class='js-date' expr:datetime='data:post.timestampISO8601'><data:post.timestamp/></time></span>
                  <b:include data='post' name='postQuickEdit'/>
                </p>
              </b:if>
            </header>
            <div class='entry-panel'/>
            <div class='entry-body post-body' expr:id='&quot;post-body-&quot; + data:post.id'>
              <data:post.body/>
            </div>
            <div class='entry-more'/>
            <b:if cond='data:blog.pageType == &quot;item&quot;'>
              <div class='entry-share'>
                <span class='entry-share-label'>Share</span>
                <a expr:href='&quot;https://api.whatsapp.com/send?text=&quot; + data:post.url' rel='nofollow noopener' target='_blank'>WhatsApp</a>
                <a expr:href='&quot;https://www.facebook.com/sharer/sharer.php?u=&quot; + data:post.url' rel='nofollow noopener' target='_blank'>Facebook</a>
                <a expr:href='&quot;https://www.linkedin.com/sharing/share-offsite/?url=&quot; + data:post.url' rel='nofollow noopener' target='_blank'>LinkedIn</a>
                <button expr:data-copy-url='data:post.url' type='button'>Copy link</button>
              </div>
              <div class='entry-reviews'>
                <b:include data='post' name='comment_picker'/>
              </div>
            </b:if>
          </article>
        </b:includable>

        <b:includable id='dirListPager'>
          <nav aria-label='Pages' class='pager'>
            <b:if cond='data:newerPageUrl'>
              <a class='btn btn-ghost newer' expr:href='data:newerPageUrl'>&#8592; Newer</a>
            </b:if>
            <b:if cond='data:olderPageUrl'>
              <a class='btn btn-primary older' expr:href='data:olderPageUrl'>More &#8594;</a>
            </b:if>
          </nav>
        </b:includable>

        <b:includable id='dirNotFound'>
          <div class='not-found'>
            <p class='not-found-code'>404</p>
            <h1>Page not found</h1>
            <p>This page has moved or no longer exists. Try the search above.</p>
            <a class='btn btn-primary' expr:href='data:blog.homepageUrl'>Back to home</a>
          </div>
        </b:includable>

        <!-- Comment includables below are Blogger's own, taken from a theme Blogger accepted -->
@@BLOG_COMMENTS@@
      </b:widget>
    </b:section>
  </div>
</div>

