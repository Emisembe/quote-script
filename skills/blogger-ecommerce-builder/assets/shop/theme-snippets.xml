<!--
  Pieces that wire the shop into a blogger-theme-builder project (src/theme.xml + src/skin.css).
  Widget ids are examples: keep them TypeN and unique in the whole theme.
-->

<!-- 1. Skin variables: add inside the skin's opening Variable comment (src/skin.css).
        They show up in Theme > Customise, so the owner can recolour the shop. -->
<Variable name="shop.accent" description="Shop accent (buttons, prices, badges)" type="color" default="#FF3300" value="#FF3300"/>
<Variable name="shop.ink" description="Shop text" type="color" default="#222222" value="#222222"/>
<Variable name="shop.tile" description="Product photo background" type="color" default="#EBE2D9" value="#EBE2D9"/>


<!-- 2. Language picker + cart button: put them in the header markup (not inside a gadget, so they are on every page).
        Mark fixed theme words for translation: data-i18n (text), data-i18n-placeholder, data-i18n-label (aria-label). -->
<div class='lang-switch' data-lang-switch='' hidden='hidden'/>
<a aria-label='Cart' class='cart-button' data-cart-open='' data-i18n-label='' href='#cart'>
  <svg aria-hidden='true' height='22' viewBox='0 0 24 24' width='22'><path d='M6 6h15l-1.5 9h-12z' fill='none' stroke='currentColor' stroke-width='2'/><circle cx='9' cy='20' fill='currentColor' r='1.5'/><circle cx='18' cy='20' fill='currentColor' r='1.5'/><path d='M6 6L5 2H2' fill='none' stroke='currentColor' stroke-width='2'/></svg>
  <span data-cart-count='' hidden='hidden'>0</span>
</a>


<!-- 3. Settings section: unconditional (so it stays editable in Layout), hidden on the site by CSS.
        Paste settings-gadget.html content into HTML91's content box. -->
<div class='shop-admin'>
  <b:section class='shop-settings-section' id='shop-settings' showaddelement='no'>
    <b:widget id='HTML91' locked='true' title='Shop settings' type='HTML'>
      <b:widget-settings>
        <b:widget-setting name='content'><![CDATA[currency: EUR
language: en
languages: en, de, fr
shipping: 0
whatsapp:
telegram:
email:
google_sheet:]]></b:widget-setting>
      </b:widget-settings>
      <b:includable id='main'>
        <div class='shop-settings'><data:content/></div>
      </b:includable>
    </b:widget>
    <b:widget id='HTML92' locked='false' title='Shop words (optional translations)' type='HTML'>
      <b:widget-settings>
        <b:widget-setting name='content'><![CDATA[[de] Send order: Zahlungspflichtig bestellen]]></b:widget-setting>
      </b:widget-settings>
      <b:includable id='main'>
        <div class='shop-words'><data:content/></div>
      </b:includable>
    </b:widget>
  </b:section>
</div>
<!-- skin.css:
     .shop-admin { display: none; }
     body#layout .shop-admin { display: block; }
-->


<!-- 4. Script: after the theme's own script, at the end of <body>. With blogger-theme-builder,
        add a @@SHOP_JS@@ marker here and map it to src/shop.js in build.py's parts. -->
<script>//<![CDATA[
@@SHOP_JS@@
//]]></script>


<!-- 5. Optional "Talk to us" call and video buttons (shop.js renders every <div class='shop-contact'>).
        One line per button: type: link or number | times | own button text. Types: call, zoom, meet,
        teams, whatsapp, telegram, email; "text:" adds an intro line. Put it in an unconditional section. -->
<b:widget id='HTML11' locked='false' title='Talk to us' type='HTML'>
  <b:widget-settings>
    <b:widget-setting name='content'><![CDATA[text: Prefer to talk? Call us or join a video call at these times.
call: +49 157 00000000 | Mon–Fri 9:00–18:00
zoom: https://zoom.us/j/0000000000 | Tue & Thu 18:00–19:00
meet: https://meet.google.com/abc-defg-hij | Sat 10:00–12:00]]></b:widget-setting>
  </b:widget-settings>
  <b:includable id='main'>
    <b:if cond='data:title != &quot;&quot;'>
      <h2 class='title'><data:title/></h2>
    </b:if>
    <div class='shop-contact'><data:content/></div>
    <b:include name='quickedit'/>
  </b:includable>
</b:widget>


<!-- 6. Delivery options (checkout chooser). Put it inside the hidden shop-admin section next to HTML91/HTML92.
        One option per line: name | price or weight steps | delivery time | info page link | countries. -->
<b:widget id='HTML93' locked='false' title='Delivery options' type='HTML'>
  <b:widget-settings>
    <b:widget-setting name='content'><![CDATA[DHL Parcel | 4,90 up to 2 kg; 6,99 up to 5 kg; 10,49 up to 10 kg | 2–4 working days | /p/delivery.html#dhl | Germany
Pickup in Berlin | 0 | By appointment | /p/delivery.html#pickup | Germany]]></b:widget-setting>
  </b:widget-settings>
  <b:includable id='main'>
    <div class='shop-delivery'><data:content/></div>
  </b:includable>
</b:widget>


<!-- 7. Logo row: "Our partners" (homepage) or accreditation seals (footer). One logo per line:
        Name | https://logo-image | https://website (optional). No image = name as a badge.
        Put it in an unconditional section; hide it off the homepage with CSS if wanted. -->
<b:widget id='HTML12' locked='false' title='Our partners' type='HTML'>
  <b:widget-settings>
    <b:widget-setting name='content'><![CDATA[Partner name | https://example.com/logo.png | https://example.com]]></b:widget-setting>
  </b:widget-settings>
  <b:includable id='main'>
    <b:if cond='data:title != &quot;&quot;'>
      <h2 class='title'><data:title/></h2>
    </b:if>
    <div class='shop-logos'><data:content/></div>
    <b:include name='quickedit'/>
  </b:includable>
</b:widget>


<!-- 8. Product block for a digital product, and weight/size for a physical one (in the post, HTML view):
<div class="product" data-price="12,90" data-digital="yes">Price: 12,90 EUR (digital download)</div>
<div class="product" data-price="64,90" data-weight="0.8" data-dimensions="38 x 30 x 12 cm">Price: 64,90 EUR</div>
-->


<!-- 9. Announcement bar: its own section BEFORE the header (unconditional, so it shows on every page).
        One message per line, optional link after |. Empty gadget = no bar. -->
<div class='announce' id='announce'>
  <b:section class='announce-section' id='announce-widgets' maxwidgets='1' showaddelement='no'>
    <b:widget id='HTML14' locked='false' title='Announcement bar' type='HTML'>
      <b:widget-settings>
        <b:widget-setting name='content'><![CDATA[Free shipping from 50 € | /p/shipping.html
Order easily on WhatsApp or Telegram]]></b:widget-setting>
      </b:widget-settings>
      <b:includable id='main'>
        <div class='shop-announce'><data:content/></div>
        <b:include name='quickedit'/>
      </b:includable>
    </b:widget>
  </b:section>
</div>
<!-- skin.css: .announce { background: $(accent.color); color: #fff; } .announce[hidden] { display: none; } -->


<!-- 10. Trust row above the footer: icon | title | small text | link, and "pay:" for payment badges. -->
<b:widget id='HTML15' locked='false' title='Trust row' type='HTML'>
  <b:widget-settings>
    <b:widget-setting name='content'><![CDATA[truck | Free shipping from 50 € | Delivered in 2–4 working days | /p/delivery.html
return | 14-day returns | Easy and personal | /p/returns.html
lock | Secure payment | PayPal or bank transfer
chat | Personal service | We answer within a day | /p/contact.html
pay: PayPal, Bank transfer, Cash on delivery]]></b:widget-setting>
  </b:widget-settings>
  <b:includable id='main'>
    <div class='shop-trust'><data:content/></div>
    <b:include name='quickedit'/>
  </b:includable>
</b:widget>

<!-- 11. Homepage block + request form. Section: unconditional, hidden in skin CSS
     (.faq { display:none }) and revealed by the homepage <style> in head
     (.hero, .services, .steps, .testimonials, .faq, .newsletter { display:block }).
     Same pattern for shop-services (HTML16), shop-steps (HTML17), shop-testimonials (HTML18),
     shop-newsletter (HTML20). Note: '&' in a title must be written '&amp;'. -->
<b:section class='faq' id='faq' maxwidgets='1' name='FAQ' showaddelement='no'>
<b:widget id='HTML19' locked='false' title='Questions &amp; answers' type='HTML'>
  <b:widget-settings>
    <b:widget-setting name='content'><![CDATA[<div class='shop-faq'>
How long does delivery take? | 2–4 working days in Germany.
Can I return an item? | Yes, within 14 days.
<div data-lang="de">
Wie lange dauert der Versand? | 2–4 Werktage in Deutschland.
</div>
</div>]]></b:widget-setting>
  </b:widget-settings>
  <b:includable id='main'>
    <b:if cond='data:title != &quot;&quot;'><h2 class='title'><data:title/></h2></b:if>
    <div class='widget-content'><data:content/></div>
    <b:include name='quickedit'/>
  </b:includable>
</b:widget>
</b:section>

<!-- Request form inside a page or post (HTML view). Sends to the Requests tab of the order sheet. -->
<div class="shop-lead" data-kind="quote" data-button="Ask for a quote"
     data-fields="Name*; Email*; Phone; Service: Storage / Packing / Shipping; Message"></div>

